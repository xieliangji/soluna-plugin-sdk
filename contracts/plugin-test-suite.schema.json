{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "kind": {
      "enum": [
        "app-log",
        "ocr",
        "special"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300000
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "timeoutMs": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 300000
                },
                "request": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "capability": {
                      "type": "string",
                      "minLength": 1
                    },
                    "capabilityVersion": {
                      "type": "string",
                      "minLength": 1
                    },
                    "runId": {
                      "type": "string"
                    },
                    "actionId": {
                      "type": "string"
                    },
                    "arguments": {
                      "type": "object"
                    },
                    "runtimeVariables": {
                      "type": "object"
                    },
                    "resources": {
                      "type": "array",
                      "maxItems": 0
                    }
                  },
                  "required": [
                    "capability",
                    "capabilityVersion",
                    "arguments"
                  ]
                },
                "files": {
                  "type": "array",
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "mediaType": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "id",
                      "path",
                      "mediaType"
                    ]
                  }
                },
                "expect": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "result": {
                      "type": "object"
                    },
                    "errorContains": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [],
                  "oneOf": [
                    {
                      "required": [
                        "result"
                      ],
                      "not": {
                        "required": [
                          "errorContains"
                        ]
                      }
                    },
                    {
                      "required": [
                        "errorContains"
                      ],
                      "not": {
                        "required": [
                          "result"
                        ]
                      }
                    }
                  ]
                },
                "outputs": {
                  "type": "object",
                  "maxProperties": 32
                }
              },
              "required": [
                "name",
                "timeoutMs",
                "request",
                "expect"
              ]
            }
          },
          "profile": {
            "type": "object"
          },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "result": {
                "type": "object"
              },
              "errorContains": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [],
            "oneOf": [
              {
                "required": [
                  "result"
                ],
                "not": {
                  "required": [
                    "errorContains"
                  ]
                }
              },
              {
                "required": [
                  "errorContains"
                ],
                "not": {
                  "required": [
                    "result"
                  ]
                }
              }
            ]
          },
          "host": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "phase": {
                  "enum": [
                    "prepare",
                    "run",
                    "cleanup", "report"
                  ]
                },
                "method": {
                  "enum": [
                    "host.call",
                    "host.event",
                    "host.variable",
                    "host.resource", "host.resource.read", "host.observe"
                  ]
                },
                "params": {
                  "type": "object",
                  "minProperties": 1
                },
                "result": {},
                "error": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "phase",
                "method",
                "params"
              ],
              "oneOf": [
                {
                  "required": [
                    "result"
                  ],
                  "not": {
                    "required": [
                      "error"
                    ]
                  }
                },
                {
                  "required": [
                    "error"
                  ],
                  "not": {
                    "required": [
                      "result"
                    ]
                  }
                }
              ]
            }
          }
        },
        "required": [
          "name",
          "timeoutMs"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "cases"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.io.soluna.local/plugin-test/1.0/suite.schema.json",
  "title": "Soluna offline plugin integration fixtures",
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "special"
          }
        }
      },
      "then": {
        "properties": {
          "cases": {
            "items": {
              "required": [
                "profile",
                "expect"
              ],
              "not": {
                "required": [
                  "steps"
                ]
              },
              "properties": {
                "expect": {
                  "required": [
                    "result"
                  ],
                  "not": {
                    "required": [
                      "errorContains"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "cases": {
            "items": {
              "required": [
                "steps"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "profile"
                    ]
                  },
                  {
                    "required": [
                      "host"
                    ]
                  },
                  {
                    "required": [
                      "expect"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
