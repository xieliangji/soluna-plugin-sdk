{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.io.soluna.local/v1/plugin-manifest.schema.json",
  "title": "Soluna external process plugin manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "protocolVersion", "executable", "capabilities", "resources"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "id": {"$ref": "#/$defs/id"},
    "name": {"$ref": "#/$defs/nonEmptyString"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "protocolVersion": {"const": "1.0"},
    "executable": {"$ref": "#/$defs/nonEmptyString"},
    "arguments": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 4096}},
    "workingDirectory": {"$ref": "#/$defs/nonEmptyString"},
    "environmentAllowlist": {"type": "array", "uniqueItems": true, "maxItems": 128, "items": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"}},
    "checksumSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "capabilities": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/capability"}},
    "resources": {"$ref": "#/$defs/resources"},
    "restart": {"$ref": "#/$defs/restart"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "nonEmptyString": {"type": "string", "minLength": 1, "maxLength": 4096},
    "capability": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "kind"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "kind": {"enum": ["action", "assertion"]},
        "idempotent": {"type": "boolean", "default": false}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false, "required": ["outputDirectory"],
      "properties": {
        "readRoots": {"type": "array", "uniqueItems": true, "maxItems": 32, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "outputDirectory": {"$ref": "#/$defs/nonEmptyString"},
        "maxResourceBytes": {"type": "integer", "minimum": 1, "maximum": 1073741824, "default": 67108864}
      }
    },
    "restart": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "maxRestarts": {"type": "integer", "minimum": 0, "maximum": 10, "default": 0},
        "windowMs": {"type": "integer", "minimum": 1000, "maximum": 3600000, "default": 60000}
      }
    }
  }
}
