{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "const": "special/1.0"
    },
    "pluginId": {
      "type": "string",
      "minLength": 1
    },
    "executable": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "android",
              "ios"
            ]
          }
        },
        "profileVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "profileSchema": {
          "type": "object"
        },
        "resultSchema": {
          "type": "object"
        },
        "resultGuide": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version",
        "platforms",
        "profileVersions",
        "profileSchema",
        "resultSchema",
        "resultGuide"
      ]
    }
  },
  "required": [
    "protocolVersion",
    "pluginId",
    "executable",
    "sha256",
    "descriptor"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.io.soluna.local/v1/special-plugin-manifest.schema.json",
  "title": "专项进程插件清单 1.0"
}
